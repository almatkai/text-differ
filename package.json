{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "text-differ",
  "title": "Text Differ",
  "description": "Opens Text Differ from selected files",
  "icon": "command-icon.png",
  "author": "almatkai",
  "categories": [
    "Applications",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "open-with-text-differ",
      "title": "Open With Text Differ",
      "description": "When two files are selected in finder the command will open them in Text Differ",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.text-differ",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/text-differ",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/text-differ",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
